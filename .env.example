# Copy to .env and adjust. Variables already set in the environment take precedence.
# Relative paths are resolved against the repository root.

ENFOR_MODELS=resource/models        # one Hugging Face folder per open model (e.g. resource/models/gpt-oss-120b)
ENFOR_DATASETS=resource/datasets    # public benchmarks: FoREST, RouteSurvey, RoomSpace, SpatialEval, SpaceNLI
ENFOR_OUTPUT=outputs                # parse and CoT logs, results

# ANTHROPIC_API_KEY=                # only for Claude models
# HF_TOKEN=                         # only to download gated checkpoints
# VLLM_CACHE_ROOT=/tmp/enfor/vllm   # optional runtime caches
